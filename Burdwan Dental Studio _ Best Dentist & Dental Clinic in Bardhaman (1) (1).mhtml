@charset "utf-8";

body { font-family: "Plus Jakarta Sans", system-ui, sans-serif; overflow-x: hidden; -webkit-tap-highlight-color: transparent; }

h1, h2, h3, h4, .font-heading { font-family: Outfit, "Plus Jakarta Sans", sans-serif; }

@keyframes slideInLeft { 
  0% { opacity: 0; transform: translateX(-50px); }
  100% { opacity: 1; transform: translateX(0px); }
}

@keyframes slideInUpRight { 
  0% { opacity: 0; transform: translate(50px, 60px); }
  100% { opacity: 1; transform: translate(0px, 0px); }
}

.animate-left-entrance { animation: 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0s 1 normal forwards running slideInLeft; }

.animate-right-entrance { animation: 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0s 1 normal forwards running slideInUpRight; }
